#!/usr/bin/env node
// deck-drafts — CLI the orchestrator runs to stage DFL epics in the Deck
// (/pontos → "Rascunhos para o DFL"). Samuel reviews there and one click
// dispatches the agent that creates epic + delivery + tasks in DFL. This CLI
// never talks to DFL. The backend watches the file and updates every device live.
//
// Usage:
//   deck-drafts list
//   deck-drafts add-epic "<title>"
//   deck-drafts add-task <epicId> "<title>" <points> [refs...]
//   deck-drafts set-status <id>[,<id>...] draft|dispatched|created   (epic, delivery or task ids)
//   deck-drafts import <file.md|->      (## Épico N — Title — X pt / ### Delivery / - Task — refs — pts)
//
// Imports the pure shared modules straight from TS (native Node type stripping),
// so validation is the same one the server runs. Honors COCKPIT_DFL_DRAFTS.

import { readFileSync, writeFileSync, renameSync, mkdirSync } from 'node:fs';
import { homedir } from 'node:os';
import { join, dirname } from 'node:path';
import { randomBytes } from 'node:crypto';
import { applyDraftOp, sanitizeDrafts, draftPoints } from '../shared/dfl-drafts.ts';
import { parseDraftsMarkdown } from '../shared/dfl-drafts-md.ts';
import { withFileLockSync } from '../shared/file-lock.ts';

const USAGE = `uso:
  deck-drafts list
  deck-drafts add-epic "<título>"
  deck-drafts add-task <epicId> "<título>" <pontos> [refs...]
  deck-drafts set-status <id>[,<id>...] draft|dispatched|created   (ids de épico, delivery ou task)
  deck-drafts import <arquivo.md|->   (- = stdin; ## Épico — título — pts / ### delivery opcional / - task — refs — pts)`;

const file = () => process.env.COCKPIT_DFL_DRAFTS || join(homedir(), '.cockpit', 'dfl-drafts.json');
const newId = (prefix) => `${prefix}-${randomBytes(3).toString('hex')}`;

function die(msg) {
  process.stderr.write(`erro: ${msg}\n${USAGE}\n`);
  process.exit(1);
}

function load() {
  try { return sanitizeDrafts(JSON.parse(readFileSync(file(), 'utf8'))); } catch { return []; }
}

function save(drafts) {
  const f = file();
  mkdirSync(dirname(f), { recursive: true });
  const tmp = `${f}.${process.pid}.tmp`;
  writeFileSync(tmp, JSON.stringify(drafts, null, 2) + '\n', 'utf8');
  renameSync(tmp, f);
}

function apply(drafts, op) {
  try { return applyDraftOp(drafts, op, { now: Date.now(), newId }); } catch (e) { die(e.message); }
}

const fmt = (n) => String(n).replace('.', ',');

function list() {
  const drafts = load();
  if (!drafts.length) return process.stdout.write('(nenhum rascunho)\n');
  for (const d of drafts) {
    process.stdout.write(`${d.id}  [${d.status}]  ${d.title} — ${fmt(draftPoints(d))} pt (${d.tasks.length} tasks)\n`);
    for (const dl of d.deliveries) process.stdout.write(`  ${dl.id}  ${dl.title} (${dl.taskIds.length} tasks)\n`);
  }
}

// Every read-modify-write takes the same lock as the server (dfl-drafts.ts):
// the browser edits this file through the agent while this CLI imports into it,
// and without the lock one side's write dropped the other's. A die() inside
// exits holding it; the lock is reclaimed as stale after 5s.
const locked = (fn) => withFileLockSync(file(), fn);

function addEpic([title]) {
  const next = locked(() => { const n = apply(load(), { op: 'add-epic', title }); save(n); return n; });
  const d = next[next.length - 1];
  process.stdout.write(`✓ épico ${d.id}: ${d.title}\n`);
}

function addTask([epicId, title, rawPoints, ...refs]) {
  if (!epicId) die('epicId obrigatório');
  const points = Number(String(rawPoints ?? '').replace(',', '.'));
  locked(() => save(apply(load(), { op: 'add-task', epicId, title, points, refs })));
  process.stdout.write(`✓ task em ${epicId}: ${title} (${fmt(points)} pt)\n`);
}

function setStatus([raw, status]) {
  const ids = String(raw ?? '').split(',').map((s) => s.trim()).filter(Boolean);
  if (!ids.length) die('id obrigatório');
  locked(() => save(apply(load(), { op: 'set-status', id: ids, status })));
  process.stdout.write(`✓ ${ids.join(', ')} → ${status}\n`);
}

// Idempotent: an epic whose title is already staged is skipped, so re-running
// the import after editing the file never duplicates cards.
function importMd([path]) {
  if (!path) die('arquivo obrigatório');
  let md;
  // "-" reads stdin, so an agent can pipe a heredoc without writing a file.
  try { md = readFileSync(path === '-' ? 0 : path, 'utf8'); } catch { die(`não consegui ler ${path}`); }
  const { epics, warnings } = parseDraftsMarkdown(md);
  if (!epics.length) die('nenhum "## Épico" encontrado');
  let added = 0;
  locked(() => {
    let drafts = load();
    const seen = new Set(drafts.map((d) => d.title));
    for (const e of epics) {
      if (seen.has(e.title)) { process.stdout.write(`· já existe: ${e.title}\n`); continue; }
      drafts = apply(drafts, { op: 'add-epic', title: e.title, deliveries: e.deliveries });
      added++;
      process.stdout.write(`✓ ${drafts[drafts.length - 1].id}  ${e.title} — ${fmt(draftPoints(drafts[drafts.length - 1]))} pt\n`);
    }
    if (added) save(drafts);
  });
  for (const w of warnings) process.stderr.write(`aviso: ${w}\n`);
  process.stdout.write(`${added} épico(s) importado(s)\n`);
}

const [cmd, ...rest] = process.argv.slice(2);
const cmds = { list, 'add-epic': addEpic, 'add-task': addTask, 'set-status': setStatus, import: importMd };
if (!cmds[cmd]) die(`comando desconhecido: ${cmd || '(vazio)'}`);
cmds[cmd](rest);
