{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // Alguns testes ao lado da fonte são guards de build: leem o .tsx irmão com
    // node:fs e conferem o que o bundler vai enxergar. Rodam em Node, mas moram
    // no projeto do browser — sem declarar aqui, o TS 7 não acha `node:fs`.
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "shared", "*.ts"]
}
