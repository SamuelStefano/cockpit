{
  "name": "deck-desktop",
  "private": true,
  "version": "0.1.1",
  "description": "Deck desktop app",
  "author": "Samuel Stefano",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --win --dir --publish never",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^25.9.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.devfellowship.deck",
    "productName": "Deck",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**",
      "assets/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Deck-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SamuelStefano",
        "repo": "cockpit"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": false
    }
  }
}
