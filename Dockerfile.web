# SPA image for Dokploy: Vite build served by nginx. VITE_* are public by design (bundled).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_WS_URL
RUN test -n "$VITE_SUPABASE_URL" && test -n "$VITE_SUPABASE_ANON_KEY" && test -n "$VITE_WS_URL" \
  || (echo "missing VITE_* build args: the SPA would not reach the relay" >&2; exit 1)
RUN npx vite build && grep -rqF "$VITE_WS_URL" dist/assets \
  || (echo "relay URL not found in the bundle" >&2; exit 1)

FROM nginx:1.27-alpine
COPY deploy/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
