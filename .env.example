# Deck — variáveis de ambiente. Copie pra .env (gitignored) e preencha.
#
# São TRÊS processos distintos lendo daqui, e a distinção importa:
#   backend  server/   — lê process.env; é onde segredo pode viver.
#   relay    relay/    — processo separado, sobe sozinho (relay/deploy/).
#   browser  src/      — SÓ enxerga as VITE_*, e elas vão pro bundle. Prefixar um
#                        segredo com VITE_ é publicá-lo. Nunca faça isso.
# Tudo aqui tem default no código; nada é obrigatório pro backend subir. As únicas
# obrigatórias são as do relay, e só se você for rodar o relay.

# ── Backend: rede e acesso ──────────────────────────────────────────────────
# Porta do backend (default 7777). O bind é sempre 127.0.0.1.
COCKPIT_PORT=7777
# Token exigido no handshake do WS. Vazio = sem gate, e aí só o loopback protege.
# Setar isto é o que torna seguro expor o app fora do loopback (Tailscale/Vercel):
# sem o token a conexão fecha com 4401. `npm run fellow` gera um forte e imprime
# se esta var não vier setada.
COCKPIT_TOKEN=
# Origens extras aceitas no handshake (CSV). Vazio = só origens locais.
COCKPIT_ALLOWED_ORIGINS=
# "Este deploy é a box do dono" — desacopla o gate de bypass do bind (DR-017).
# Default = true, porque hoje o host é sempre loopback. 0/1 sobrescreve.
COCKPIT_LOCAL_ONLY=
# Diretório de trabalho do agente (default: seu HOME). Define também de qual
# projeto do CLI as sessões são lidas — o slug é derivado deste caminho.
COCKPIT_WORKDIR=

# ── Backend: turno e modelo ─────────────────────────────────────────────────
# Modo de permissão do `claude -p`: plan (default) | default | acceptEdits.
# 'bypassPermissions' é recusado aqui por design; o caminho pra ele é o toggle
# admin, atrás de COCKPIT_ALLOW_BYPASS.
COCKPIT_PERMISSION_MODE=
# Liga o toggle de bypass (exige AINDA role admin + localOnly). Só '1' liga.
# Default off. Numa box com sudo NOPASSWD + docker, bypass = RCE root.
COCKPIT_ALLOW_BYPASS=
# Modelo pra onde cair quando o primário está sobrecarregado. Vazio = sem fallback.
COCKPIT_FALLBACK_MODEL=sonnet
# Teto de runs `claude -p` simultâneos (default 12).
COCKPIT_MAX_RUNS=12
# Teto de gasto por run em USD imposto pelo servidor (--max-budget-usd). O cliente
# só aperta, nunca afrouxa. Vazio = sem teto do servidor (box do dono).
COCKPIT_MAX_BUDGET_USD=
# Quantas mensagens do fim da sessão o history devolve (default 2000).
COCKPIT_HISTORY_LIMIT=2000
# TTL dos anexos gravados no workdir, em ms (default 7 dias).
COCKPIT_ATTACHMENT_TTL_MS=
# Resumo IA de 1 frase por turno. Qualquer valor diferente de 'off' mantém ligado.
COCKPIT_SUMMARY=
# Modelo do resumo — separado do chat pra o custo ficar previsível.
COCKPIT_SUMMARY_MODEL=claude-haiku-4-5-20251001

# ── Backend: allow-list de ferramentas ──────────────────────────────────────
# CSV. Vazio = usa o default do código (Bash, Read, Edit, Write, Glob, Grep,
# WebFetch, WebSearch, AskUserQuestion e as tools de task). Cuidado ao encurtar:
# como o `claude -p` roda sem control protocol, tool fora da lista é negada em
# SILÊNCIO — o sintoma não é um erro, é uma funcionalidade que some.
COCKPIT_ALLOWED_TOOLS=
# Idem para o modo Auto (o agente roda o ciclo sozinho).
COCKPIT_ALLOWED_TOOLS_AUTO=
# Kill-switch duro: negadas em TODOS os modos, precede as allow-lists acima.
# Ex.: COCKPIT_DISALLOWED_TOOLS=WebFetch,WebSearch trava saída de rede.
COCKPIT_DISALLOWED_TOOLS=

# ── Backend: chave da API Anthropic ─────────────────────────────────────────
# Opcionais: o CLI já usa o login local do plano. Servem pra pendurar o que NÃO
# deve consumir a quota do plano (o resumo por turno, watchdogs) numa key à parte.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# ── Backend: integrações opcionais ──────────────────────────────────────────
# Espelho S3 dos anexos, via edge function pré-setada. Sem a anon key o S3 fica
# desligado e o app cai no fluxo local de sempre.
DECK_S3_UPLOAD_URL=
DECK_S3_ANON_KEY=
# Binário do graphify. Vazio = resolve pelo PATH.
COCKPIT_GRAPHIFY_BIN=
# Integração DFL (pontos/flows). Todas têm default no código; sobrescreva só se
# estiver apontando pra outro ambiente.
DFL_FLOWS_API=
DFL_FELLOW_ID=
DFL_ORG_ID=
DFL_OWNER_ID=
DFL_MCP_DIR=

# ── Agente (server/agent.ts, processo separado do backend) ──────────────────
# Diretório de identidade/rotas do agente (default ~/.deck-agent).
DECK_AGENT_DIR=
# 'admin' habilita o papel de admin; qualquer outro valor = student.
DECK_AGENT_ROLE=
# URL do relay que o agente disca. Vazio = agente não se conecta a relay nenhum.
DECK_RELAY_URL=
# Código de pareamento lido só quando o agente roda com `--pair` (sem valor). Evita
# o código no argv, que qualquer usuário local lê no `ps`.
DECK_PAIR_CODE=

# ── Relay (relay/, processo separado; DR-023) ───────────────────────────────
# ESTAS DUAS SÃO OBRIGATÓRIAS: sem elas o relay loga "faltando env" e sai com 1.
# Projeto Supabase dedicado deck-relay (NÃO o stack do DFL prod). A URL do JWKS
# usada pra verificar o JWT é derivada daqui — não existe var separada pra ela.
SUPABASE_URL=https://ikxtdssxmcgipyfpwmar.supabase.co
# Service role: só no service-path (setar is_admin, marcar code usado).
# NUNCA prefixar com VITE_ (vazaria no bundle). Manter fora do git.
SUPABASE_SERVICE_ROLE_KEY=
# Allowlist de emails root (CSV) — NUNCA flag de banco.
COCKPIT_ROOT_EMAILS=
# Bind do relay (defaults 127.0.0.1:8800).
RELAY_HOST=
RELAY_PORT=
# Qualquer valor liga log verboso de roteamento.
DECK_RELAY_DEBUG=

# ── Browser (vão pro bundle — nada de segredo aqui) ─────────────────────────
# Frontend separado (Vercel) → aponta o WS pro host real do backend.
VITE_WS_URL=
VITE_SUPABASE_URL=https://ikxtdssxmcgipyfpwmar.supabase.co
# anon/publishable key (pública por design).
VITE_SUPABASE_ANON_KEY=

# ── Caminhos de estado (override; existem sobretudo pra teste) ──────────────
# Todo arquivo de estado mora em ~/.cockpit com um override de caminho. Só mexa
# se souber por quê — e mexa nos DOIS lados quando houver leitor externo: o
# scripts/incident-ai.sh lê COCKPIT_INCIDENTS que o backend escreve.
COCKPIT_DB=
COCKPIT_STORE=
COCKPIT_INCIDENTS=
COCKPIT_AWAITING=
COCKPIT_PLAN_USAGE=
COCKPIT_PARKED=
COCKPIT_QUEUE_PAUSE=
COCKPIT_MARATHON=
COCKPIT_LIVE_RUNS=
COCKPIT_CRONS=
COCKPIT_NOTES=
COCKPIT_POINTS=
COCKPIT_DFL_POINTS=
COCKPIT_GRAPHS_DIR=
# Dir dos drops privados (padrão ~/.deck-drop, 0700 com arquivos 0600). Aponte
# pra um dir SÓ seu: é onde o segredo entregue fora do chat fica no disco.
COCKPIT_DROP_DIR=
