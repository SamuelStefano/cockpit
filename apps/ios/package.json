{
  "name": "@deck/ios",
  "version": "0.1.0",
  "private": true,
  "description": "The Deck iOS shell: Expo Router plus one WebView on the Deck origin. Outside the root workspaces on purpose (own lockfile, own React).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "bundle:ios": "expo export --platform ios --output-dir dist-ios --dump-sourcemap",
    "bundle:web": "node scripts/bundle-web.mjs",
    "eas-build-post-install": "if [ \"$DECK_WEB_BUNDLE\" = \"1\" ]; then node scripts/bundle-web.mjs; fi",
    "doctor": "expo-doctor",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run --config vitest.config.ts && node --test scripts/asc-store.test.mjs",
    "check:native-config": "node scripts/assert-native-config.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
