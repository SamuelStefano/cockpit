    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Deck looks at your most recent screenshot, only after you turn on automatic screenshots, to offer to paste it into your chat. A screenshot is sent to your agent only when you tap to paste it.",
