# deck-ops admin app for Dokploy. No npm install: zero runtime dependencies,
# TypeScript runs through Node's built-in type stripping.
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY ops/package.json ./
COPY ops/src ./src
RUN rm -f src/*.test.ts && mkdir -p /data && chown node:node /data
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- "http://127.0.0.1:${PORT:-3000}/healthz" || exit 1
CMD ["node", "--disable-warning=ExperimentalWarning", "--experimental-strip-types", "src/main.ts"]
